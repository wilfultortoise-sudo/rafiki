---
import BaseLayout from "./BaseLayout.astro";

const { title, description, pubDate, author, image } = Astro.props;
---

<BaseLayout title={title}>
  <article>
    <header>
      <h1>{title}</h1>

      <p>{description}</p>

      <div>
        <strong>Autor:</strong> {author}
      </div>

      <div>
        <strong>Publicado:</strong>
        {pubDate.toLocaleDateString("es-MX")}
      </div>
    </header>

    <img
      src={image.src}
      alt={title}
      class="imagen-principal"
    />

    <hr />

    <section class="contenido">
      <slot />
    </section>
  </article>
</BaseLayout>

<style>
  article {
    max-width: 750px;
    margin: auto;
  }

  header {
    margin-bottom: 30px;
  }

  h1 {
    font-size: 2.5rem;
    margin-bottom: 10px;
  }

  header p {
    color: #666;
    font-size: 1.1rem;
  }

  .imagen-principal {
    width: 100%;
    max-height: 400px;
    object-fit: contain;
    border-radius: 12px;
    margin-bottom: 20px;
  }

  hr {
    margin: 30px 0;
  }

  .contenido {
    font-size: 1.05rem;
  }
</style>