---
import "../styles/global.css";
import Header from "../components/Header.astro";

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>
  </head>

  <body>
    <Header />

    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  main {
    max-width: 900px;
    margin: 0 auto;
    padding: 40px 20px;
  }
</style>