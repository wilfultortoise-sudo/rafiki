---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = await getCollection("blog");
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Mi Blog">
  <section class="hero">
    <p id="random-quote"></p>

    <script is:inline>
      const frases = [
        "El código que no se prueba, no funciona. pero si si, ya no le muevas pai.",
        "Simplicidad es la máxima sofisticación. nada como una frase sacada de google XD.",
        "Primero hazlo funcionar, luego hazlo bonito. como los chingadazos de mi abuelita.",
      ];
      document.getElementById('random-quote').textContent =
        frases[Math.floor(Math.random() * frases.length)];
    </script>
    <div class="hero-contenido">
      <p class="etiqueta">MI BLOG PERSONAL</p>

      <h1>
        Bienvenido a mi
        <span>espacio de aprendizaje.</span>
      </h1>

      <p class="descripcion">
        Un lugar donde comparto mis experiencias, proyectos y todo lo que voy
        aprendiendo sobre programación y desarrollo de software.
      </p>

      <a href={`${base}blog/`} class="boton">
        Explorar publicaciones
      </a>
    </div>
  </section>

  <section class="publicaciones">
    <div class="encabezado">
      <div>
        <p class="etiqueta">BLOG</p>
        <h2>Últimas publicaciones</h2>
      </div>

      <a href={`${base}blog/`} class="ver-todas">
        Ver todas →
      </a>
    </div>

    <div class="grid">
      {
        posts.map((post) => (
          <a href={`${base}blog/${post.id}/`} class="tarjeta">
            <img
              src={post.data.image.src}
              alt={post.data.title}
            />

            <div class="tarjeta-contenido">
              <p class="fecha">
                {post.data.pubDate.toLocaleDateString("es-MX")}
              </p>

              <h3>{post.data.title}</h3>

              <p class="descripcion-post">
                {post.data.description}
              </p>

              <span class="leer">
                Leer publicación →
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    margin-bottom: 70px;
    padding: 80px 40px;
    border-radius: 20px;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .hero-contenido {
    max-width: 700px;
  }

  .etiqueta {
    margin: 0 0 12px;
    font-size: 0.8rem;
    font-weight: bold;
    letter-spacing: 2px;
    color: var(--muted-text-light);
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -2px;
  }

  h1 span {
    display: block;
    color: var(--accent-text);
  }

  .descripcion {
    max-width: 600px;
    margin: 25px 0;
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--muted-text);
  }

  .boton {
    display: inline-block;
    padding: 13px 22px;
    border-radius: 10px;
    background: var(--button-bg);
    color: var(--button-text);
    text-decoration: none;
    font-weight: bold;
    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }

  .boton:hover {
    transform: translateY(-3px);
    background: var(--button-hover-bg);
  }

  .publicaciones {
    margin-bottom: 60px;
  }

  .encabezado {
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 25px;
  }

  .encabezado h2 {
    margin: 0;
    font-size: 2rem;
  }

  .ver-todas {
    color: var(--accent-text);
    text-decoration: none;
    font-weight: bold;
  }

  .ver-todas:hover {
    text-decoration: underline;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 25px;
  }

  .tarjeta {
    overflow: hidden;
    display: block;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 15px;
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .tarjeta:hover {
    transform: translateY(-7px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1);
  }

  .tarjeta img {
    display: block;
    width: 100%;
    height: 220px;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .tarjeta:hover img {
    transform: scale(1.04);
  }

  .tarjeta-contenido {
    padding: 22px;
  }

  .fecha {
    margin: 0 0 10px;
    font-size: 0.85rem;
    color: var(--muted-text-light);
  }

  .tarjeta h3 {
    margin: 0 0 10px;
    font-size: 1.5rem;
  }

  .descripcion-post {
    margin: 0 0 20px;
    color: var(--muted-text);
    line-height: 1.6;
  }

  .leer {
    font-weight: bold;
    color: var(--text-color);
  }

  @media (max-width: 700px) {
    .hero {
      padding: 50px 25px;
    }

    .grid {
      grid-template-columns: 1fr;
    }

    .encabezado {
      align-items: start;
      flex-direction: column;
      gap: 10px;
    }
  }
</style>